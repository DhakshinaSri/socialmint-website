# Repository name on GitHub Pages. Final URL: https://dhakshinasri.github.io/socialmint-website/
# For a new demo, change this to "/<new-repo-name>/" (leading and trailing slash).
VITE_BASE=/socialmint-website/

# Full public URL of the site (no trailing slash). Used for canonical links, sitemap and social previews.
VITE_SITE_URL=https://dhakshinasri.github.io/socialmint-website

# Optional: a Formspree (or similar) endpoint that receives enquiry form submissions.
# Example: https://formspree.io/f/xxxxxxxx
VITE_FORM_ENDPOINT=
